# Service listener configuration
API_HOST=127.0.0.1
API_PORT=3000

# Stellar network configuration (defaults to official public Testnet)
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Example: Local standalone network (e.g. stellar/quickstart container)
# STELLAR_NETWORK=STANDALONE
# STELLAR_HORIZON_URL=http://127.0.0.1:8000
# STELLAR_RPC_URL=http://127.0.0.1:8000/rpc

# Security notes:
# - Remote endpoints MUST use HTTPS. Plain HTTP is only permitted for localhost/127.0.0.1.
# - Never store secret keys, seed phrases, or private signing credentials in this file.
